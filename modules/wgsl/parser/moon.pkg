// Moonyacc-generated guards intentionally abort on violated parser invariants.
warnings = "-guard_inexhaustive"

import {
  "Milky2018/wgsl/ast",
  "Milky2018/wgsl/lex",
  "moonbitlang/core/list",
}

import {
  "Milky2018/wgsl/ast_analysis",
} for "wbtest"

dev_build(
  rule: "moonyacc-array",
  input: "wgsl_parser.mbty",
  output: "wgsl_generated_parser.mbt",
)
